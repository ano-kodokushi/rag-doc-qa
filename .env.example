# ── 生成模型（OpenAI 兼容端点）──
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── Embedding（默认阿里云百炼 OpenAI 兼容端点）──
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
EMBED_BATCH=10

# ── Rerank（二期可选；关闭时不发任何请求）──
RERANK_ENABLED=0
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=gte-rerank-v2
RERANK_API_KEY=

# ── 运行模式 ──
MOCK=0

# 检索结果整理模式（T-020 修订）：off / diverse / expand
#   off     = 现状，top-k 的块原样返回
#   diverse = 按 (source, heading) 去重，每个小节只留排名最高的一块，text 不扩展
#   expand  = 去重 + 把 text 换成该小节全文（实测会撞 prompt 的 3000 字符硬截断）
# 非法值或留空一律回退为 off（配置写错不该让服务起不来）
SECTION_MODE=off

# ── 路径与检索参数 ──
CHROMA_DIR=data/chroma
RAW_DIR=data/raw
CHUNKS_FILE=data/chunks.jsonl
COLLECTION=doc_qa
TOP_K_VEC=10
TOP_K_BM25=10
TOP_K_FINAL=15
CHUNK_SIZE=400
CHUNK_OVERLAP=50
